  name: quay.io/confidential-containers/cloud-api-adaptor
  tag: "v0.21.1-amd64"
secrets:
  mode: reference
  existingSecretName: ""
webhook:
  enabled: false          # needs cert-manager, our profile sets runtimeClassName itself
