    "records": [
     "records the set `offer_flight_ids` = every `flight_id` in the reply's `offers`",
     "records the map `offer_prices` = `flight_id` -> `price_minor` from the reply's `offers`",
     "records the map `offer_currencies` = `flight_id` -> `currency` from the reply's `offers`"
    ]
