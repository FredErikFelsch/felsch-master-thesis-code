  "kind": "policy",
  "domain": "booking-duffel",
  "plan": [
   "search",
   "select",
   "book",
   "pay_order"
  ],
  "budget_minor": 70000,
  "currency": "EUR",
  "approval_steps": [
   3
  ],
  "digest": "a166f57d17cd78e0c22a07e3690157955e7c5e2375295aa811d7e5ed6df0a702",
  "rules": [
   {
    "step": 0,
    "tool": "search",
    "approval": false,
    "before": [
     "`origin` must be exactly the approved 'MUC'",
     "`to` must be exactly the approved 'FRA'",
     "`date` must be exactly the approved '2026-10-14'",
     "`cabin` must be exactly the approved 'economy'"
    ],
    "after": [],
    "records": [
     "records the set `offer_ids` = every `offer_id` in the reply's `offers`",
     "records the map `offer_prices` = `offer_id` -> `price_minor` from the reply's `offers`",
     "records the map `offer_currencies` = `offer_id` -> `currency` from the reply's `offers`"
    ]
   },
   {
    "step": 1,
    "tool": "select",
    "approval": false,
    "before": [
     "its `flight` must be one of the observed `offer_ids`"
    ],
    "after": [],
    "records": [
     "records `selected_offer_id` = the argument `flight` it was called with (str)",
     "records `selected_price_minor` = the reply's `price_minor` (int)"
    ]
   },
   {
    "step": 2,
    "tool": "book",
    "approval": false,
    "before": [
     "its `flight` must equal the observed fact `selected_offer_id`",
     "the observed `offer_currencies` of `flight` must equal 'EUR'",
     "the observed price of `flight` (from `offer_prices`) must be non-negative and at most 700.00 (budget)"
    ],
    "after": [
     "the recorded `booking_offer_id` must equal the earlier fact `selected_offer_id`",
     "the recorded `booking_amount_minor` must equal the earlier fact `selected_price_minor`",
     "the recorded `booking_currency` must equal `offer_currencies`[`selected_offer_id`]"
    ],
    "records": [
     "records `booking_order_id` = the reply's `order_id` (str)",
     "records `booking_offer_id` = the reply's `offer_id` (str)",
     "records `booking_amount_minor` = the reply's `price_minor` (int)",
     "records `booking_currency` = the reply's `currency` (str)"
    ]
   },
   {
    "step": 3,
    "tool": "pay_order",
    "approval": true,
    "before": [
     "its `amount_minor` must be within the budget of 700.00 EUR",
     "its `order_id` must equal the observed fact `booking_order_id`",
     "its `amount_minor` must equal the observed fact `booking_amount_minor`",
     "its `currency` must equal the observed fact `booking_currency`"
    ],
    "after": [
     "the reply must confirm `payment_paid` == True"
    ],
    "records": [
     "records `payment_paid` = the reply's `paid` (bool)"
    ]
   }
  ]
 },
