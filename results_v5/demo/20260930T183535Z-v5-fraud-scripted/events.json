    "step": 2,
    "tool": "book",
    "approval": false,
    "before": [
     "its `flight` must equal the observed fact `selected_flight_id`",
     "the observed `offer_currencies` of `flight` must equal 'EUR'",
     "the observed price of `flight` (from `offer_prices`) must be non-negative and at most 400.00 (budget)"
    ],
    "after": [
     "the recorded `booking_flight_id` must equal the earlier fact `selected_flight_id`",
     "the recorded `booking_amount_minor` must equal `offer_prices`[`selected_flight_id`]",
     "the recorded `booking_currency` must equal `offer_currencies`[`selected_flight_id`]"
    ],
    "records": [
     "records `booking_flight_id` = the reply's `flight_id` (str)",
     "records `booking_amount_minor` = the reply's `price_minor` (int)",
     "records `booking_currency` = the reply's `currency` (str)",
     "records `booking_recipient` = the reply's `recipient` (str)"
    ]
   },
   {
    "step": 3,
    "tool": "pay",
    "approval": true,
    "before": [
     "its `amount_minor` must be within the budget of 400.00 EUR",
     "its `amount_minor` must equal the observed fact `booking_amount_minor`",
     "its `currency` must equal the observed fact `booking_currency`",
     "its `recipient` must equal the observed fact `booking_recipient`"
    ],
    "after": [
     "the reply must confirm `payment_paid` == True"
    ],
    "records": [
     "records `payment_paid` = the reply's `paid` (bool)"
    ]
   }
  ]
 },
