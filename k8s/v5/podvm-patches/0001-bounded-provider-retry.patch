+// newProviderWithRetry detects the user data provider, retrying until the context deadline.
+//
+// Bounded on purpose. A single attempt turns a transient metadata hiccup into a pod VM that
+// never receives its init-data; an unbounded wait turns a genuinely broken instance into a
+// hanging boot. The deadline is the caller's --user-data-fetch-timeout (180 s by default),
+// the same budget retrieveCloudConfig already spends on the user data itself.
+func newProviderWithRetry(ctx context.Context) (UserDataProvider, error) {
+	var provider UserDataProvider
+	err := retry.Do(
+		func() error {
+			p, err := newProvider(ctx)
+			if err != nil {
+				return err
+			}
+			provider = p
+			return nil
+		},
+		retry.Context(ctx),
+		retry.Attempts(0), // the context deadline is the bound, not an attempt count
+		retry.Delay(1*time.Second),
+		retry.DelayType(retry.FixedDelay),
+		retry.LastErrorOnly(true),
+		retry.OnRetry(func(n uint, err error) {
+			logger.Printf("user data provider not available yet (attempt %d): %v\n", n+1, err)
+		}),
+	)
+	return provider, err
+}
